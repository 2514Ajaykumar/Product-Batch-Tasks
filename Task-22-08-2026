import java.util.*;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] a = new int[n];

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        int[][] dp = new int[n][3];

        // Day 0
        dp[0][0] = 1;
        dp[0][1] = (a[0] == 1 || a[0] == 3) ? 0 : 1000000;
        dp[0][2] = (a[0] == 2 || a[0] == 3) ? 0 : 1000000;

        for (int i = 1; i < n; i++) {

            // Rest today
            dp[i][0] = Math.min(
                dp[i - 1][0],
                Math.min(dp[i - 1][1], dp[i - 1][2])
            ) + 1;

            // Contest today
            if (a[i] == 1 || a[i] == 3) {
                dp[i][1] = Math.min(
                    dp[i - 1][0],
                    dp[i - 1][2]
                );
            } else {
                dp[i][1] = 1000000;
            }

            // Gym today
            if (a[i] == 2 || a[i] == 3) {
                dp[i][2] = Math.min(
                    dp[i - 1][0],
                    dp[i - 1][1]
                );
            } else {
                dp[i][2] = 1000000;
            }
        }

        System.out.println(
            Math.min(
                dp[n - 1][0],
                Math.min(dp[n - 1][1], dp[n - 1][2])
            )
        );
    }
}

1418C — Mortal Kombat Tower

import java.util.*;

public class Main {

    static int[][] dp;
    static int[] a;
    static int n;

    static int find(int i, int turn) {

        if (i >= n) {
            return 0;
        }

        if (dp[i][turn] != -1) {
            return dp[i][turn];
        }

        int ans = Integer.MAX_VALUE;

        if (turn == 0) {

            // Friend kills 1 boss
            int one = a[i] + find(i + 1, 1);

            // Friend kills 2 bosses
            int two = Integer.MAX_VALUE;

            if (i + 1 < n) {
                two = a[i] + a[i + 1] + find(i + 2, 1);
            }

            ans = Math.min(one, two);

        } else {

            // You kill 1 boss
            int one = find(i + 1, 0);

            // You kill 2 bosses
            int two = Integer.MAX_VALUE;

            if (i + 1 < n) {
                two = find(i + 2, 0);
            }

            ans = Math.min(one, two);
        }

        return dp[i][turn] = ans;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {

            n = sc.nextInt();

            a = new int[n];

            for (int i = 0; i < n; i++) {
                a[i] = sc.nextInt();
            }

            dp = new int[n][2];

            for (int[] row : dp) {
                Arrays.fill(row, -1);
            }

            System.out.println(find(0, 0));
        }

        sc.close();
    }
}

