    public boolean canPartition(int[] nums) {
        int n=nums.length;
        int sum=0;
        for(int i:nums){
            sum+=i;
        }
        if(sum%2!=0) return false;
        int tar=sum/2;
        // int dp[][]=new int[n+1][target+1];
        // for(int i=0;i<=n;i++){
        //     Arrays.fill(dp[i],-1);
        // }
        // return find(nums,target,dp,n);
        
        boolean dp[]=new boolean[tar+1];
        dp[0]=true;
        for(int i=0;i<n;i++){
            for(int j=tar;j>=nums[i];j--){
                dp[j]=dp[j] || dp[j-nums[i]];
            }
        }
        return dp[tar];
    }
}

