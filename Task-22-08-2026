class Solution {
    HashSet<Integer>set=new HashSet<>();
    public int mincostTickets(int[] days, int[] costs) {
        int max=0;
        for(int i:days){
            // max=Math.max(i,max);
            set.add(i);
        }
        int dp[]=new int[days[days.length-1]+1];
        Arrays.fill(dp,-1);
        return find(costs,days[0],dp,days);
    }
     int find(int costs[],int cur,int dp[],int days[]){
        if(cur>days[days.length-1]) return 0;
        if(dp[cur]!=-1) return dp[cur];

        if(!set.contains(cur)){
            return dp[cur]=find(costs,cur+1,dp,days);
        }

        int one=costs[0]+find(costs,cur+1,dp,days);
        int two=costs[1]+find(costs,cur+7,dp,days);
        int three=costs[2]+find(costs,cur+30,dp,days);
        return dp[cur]=Math.min(one,Math.min(two,three));

    }
}

4 . Last Stone - II

class Solution {
    public int lastStoneWeightII(int[] stones) {
        int n=stones.length;
        int max=0;
        for(int i:stones){
            max+=i;
        }
        int dp[][]=new int[n][max+1];
        for(int i=0;i<n;i++){
            Arrays.fill(dp[i],-1);
        }
        return find(0,0,0,stones,dp);
    }
    int find(int i,int sl,int sr,int arr[],int dp[][]){
        if(i==arr.length){
            return Math.abs(sl-sr);
        }
        //  here we can also do dp[i][sl] because we are expanding sl to sr and sr to sl so they are independing 
        if(dp[i][sr]!=-1){
            return dp[i][sr];
        }

        return dp[i][sr]=Math.min(find(i+1,sl+arr[i],sr,arr,dp),find(i+1,sl,sr+arr[i],arr,dp));
    }
}


