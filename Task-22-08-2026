B. Petr and a Combination Lock

import java.util.*;

public class Main {

    static int[] arr;
    static int n;

    static boolean find(int i, int sum) {

        if (i == n) {
            return sum % 360 == 0;
        }

        if (find(i + 1, sum + arr[i])) {
            return true;
        }

        if (find(i + 1, sum - arr[i])) {
            return true;
        }

        return false;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        n = sc.nextInt();

        arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        if (find(0, 0)) {
            System.out.println("YES");
        } else {
            System.out.println("NO");
        }

        sc.close();
    }
}

