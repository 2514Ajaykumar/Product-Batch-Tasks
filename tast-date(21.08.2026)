1 ) frog jump :

import java.util.*;
public class frogjump {
    public static void main(String args[]){
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=obj.nextInt();
        }

        int dp[]=new int[n];
        dp[0]=0;
        dp[1]=Math.abs(arr[0]-arr[1]);

        for(int i=2;i<n;i++){
            int j1=dp[i-1]+Math.abs(arr[i]-arr[i-1]);
            int j2=dp[i-2]+Math.abs(arr[i]-arr[i-2]);
            dp[i]=Math.min(j1,j2);
        }

        System.out.println(dp[n-1]);

    }
}


2 ) frog jump with k distances :

import java.util.Scanner;

public class frogjumpwithk {
    public static void main(String args[]){
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int k=obj.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=obj.nextInt();
        }

        int dp[]=new int[n];
        dp[0]=0;
        // dp[1]=Math.abs(arr[0]-arr[1]);
        for(int i=1;i<n;i++){
            
            dp[i]=Integer.MAX_VALUE;
            for(int j=i-1;j>=0 && i-j<=k ; j--){
                int cost=dp[j]+Math.abs(arr[i]-arr[j]);
                dp[i]=Math.min(cost,dp[i]);
            }
            
            // int j2=Math.abs(arr[i]-dp[i-2]);
            // dp[i]=Math.min(j1,j2);
        }

        System.out.println(dp[n-1]);
        
    }
}





