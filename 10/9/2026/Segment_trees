public class segmentfirst {

    static int tree[];

    static void build(int ind, int st, int ed, int arr[]) {
        if (st == ed) {
            tree[ind] = arr[st];
            return;
        }

        int mid = (st + ed) / 2;

        build(2 * ind + 1, st, mid, arr);
        build(2 * ind + 2, mid + 1, ed, arr);

        tree[ind] = Math.max(tree[2 * ind + 1], tree[2 * ind + 2]);
    }

    static void update(int ind, int st, int ed, int index, int val) {
        if (st == ed) {
            tree[ind] = val;
            return;
        }

        int mid = (st + ed) / 2;

        if (index <= mid)
            update(2 * ind + 1, st, mid, index, val);
        else
            update(2 * ind + 2, mid + 1, ed, index, val);

        tree[ind] = Math.max(tree[2 * ind + 1], tree[2 * ind + 2]);
    }

    static int find(int ind, int st, int ed, int l, int r, int x) {
        if (ed < l || st > r || tree[ind] < x)
            return -1;

        if (st == ed)
            return st;

        int mid = (st + ed) / 2;

        int left = find(2 * ind + 1, st, mid, l, r, x);

        if (left != -1)
            return left;

        return find(2 * ind + 2, mid + 1, ed, l, r, x);
    }

