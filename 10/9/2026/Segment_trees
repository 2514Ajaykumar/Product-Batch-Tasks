        while (q-- > 0) {
            int type = obj.nextInt();

            if (type == 1) {
                int index = obj.nextInt();
                int val = obj.nextInt();

                arr[index] = val;
                update(0, 0, n - 1, index, val);

            } else {
                int l = obj.nextInt();
                int r = obj.nextInt();
                int x = obj.nextInt();

                System.out.println(find(0, 0, n - 1, l, r, x));
            }
        }
    }
