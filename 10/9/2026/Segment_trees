            if (type == 1) {
                int index = obj.nextInt();
                int val = obj.nextInt();

                arr[index] = val;
                update(0, 0, n - 1, index, val);

            } else {
                int l = obj.nextInt();
                int r = obj.nextInt();

                Node ans = find(0, 0, n - 1, l, r);

