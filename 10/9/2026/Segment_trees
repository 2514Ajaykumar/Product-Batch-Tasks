import java.util.*;

public class kthone {

    static int tree[];

    // Build Segment Tree
    // Each node stores the number of 1s in that segment
    static void build(int ind, int st, int ed, int arr[]) {

        // Leaf node
        if (st == ed) {
            tree[ind] = arr[st];
            return;
        }

        int mid = (st + ed) / 2;

        // Build left child
        build(2 * ind + 1, st, mid, arr);

        // Build right child
        build(2 * ind + 2, mid + 1, ed, arr);

        // Number of 1s = left count + right count
        tree[ind] =
                tree[2 * ind + 1] +
                tree[2 * ind + 2];
    }

    // Point Update
    static void update(
            int ind,
            int st,
            int ed,
            int index,
            int value) {

        // Reached the required position
        if (st == ed) {
            tree[ind] = value;
            return;
        }

        int mid = (st + ed) / 2;

        // Go to left child
        if (index <= mid) {

            update(
                    2 * ind + 1,
                    st,
                    mid,
                    index,
                    value
            );

        } else {

            // Go to right child
            update(
                    2 * ind + 2,
                    mid + 1,
                    ed,
                    index,
                    value
            );
        }

        // Recalculate parent
        tree[ind] =
                tree[2 * ind + 1] +
                tree[2 * ind + 2];
    }

    // Find index of k-th one
    static int findKthOne(
            int ind,
            int st,
            int ed,
            int k) {

        // Reached a leaf
        if (st == ed) {
            return st;
        }

        int mid = (st + ed) / 2;

        // Number of ones in left child
        int leftCount = tree[2 * ind + 1];

        /*
         * If left child contains at least k ones,
         * the k-th one is somewhere in the left child.
         */
        if (k <= leftCount) {

            return findKthOne(
                    2 * ind + 1,
                    st,
                    mid,
                    k
            );

        } else {

            /*
             * The k-th one is in the right child.
             *
             * We skip all the ones in the left child,
             * so reduce k by leftCount.
             */
            return findKthOne(
                    2 * ind + 2,
                    mid + 1,
                    ed,
                    k - leftCount
            );
        }
    }

    public static void main(String[] args) {

        Scanner obj = new Scanner(System.in);

        int n = obj.nextInt();

        int arr[] = new int[n];

        tree = new int[4 * n];

        // Read binary array
        for (int i = 0; i < n; i++) {
            arr[i] = obj.nextInt();
        }

        // Build Segment Tree
        build(0, 0, n - 1, arr);

        int q = obj.nextInt();

        while (q-- > 0) {

            int type = obj.nextInt();

            // Type 1: Point Update
            // 1 index value
            if (type == 1) {

                int index = obj.nextInt();
                int value = obj.nextInt();

                arr[index] = value;

                update(
                        0,
                        0,
                        n - 1,
                        index,
                        value
                );
            }

            // Type 2: Find k-th one
            // 2 k
            else if (type == 2) {

                int k = obj.nextInt();

                // Total number of ones
                int totalOnes = tree[0];

                // Not enough ones
                if (totalOnes < k) {
                    System.out.println(-1);
                } else {

                    int answer = findKthOne(
                            0,
                            0,
                            n - 1,
                            k
                    );

                    System.out.println(answer);
                }
            }
        }
    }
}

