public class segmentpairsum {

    static class Node {
        long max1, max2;

        Node(long max1, long max2) {
            this.max1 = max1;
            this.max2 = max2;
        }
    }

    static Node tree[];

    static Node merge(Node a, Node b) {
        long max1 = Math.max(a.max1, b.max1);

        long max2 = Math.max(
                Math.min(a.max1, b.max1),
                Math.max(a.max2, b.max2)
        );

        return new Node(max1, max2);
    }

    static void build(int ind, int st, int ed, int arr[]) {
        if (st == ed) {
            tree[ind] = new Node(arr[st], Long.MIN_VALUE);
            return;
        }

        int mid = (st + ed) / 2;

        build(2 * ind + 1, st, mid, arr);
        build(2 * ind + 2, mid + 1, ed, arr);

        tree[ind] = merge(tree[2 * ind + 1], tree[2 * ind + 2]);
    }

    static void update(int ind, int st, int ed, int index, int val) {
        if (st == ed) {
            tree[ind] = new Node(val, Long.MIN_VALUE);
            return;
        }

        int mid = (st + ed) / 2;

        if (index <= mid)
            update(2 * ind + 1, st, mid, index, val);
        else
            update(2 * ind + 2, mid + 1, ed, index, val);

        tree[ind] = merge(tree[2 * ind + 1], tree[2 * ind + 2]);
    }

    static Node find(int ind, int st, int ed, int l, int r) {
        if (l > ed || r < st)
            return null;

        if (l <= st && ed <= r)
            return tree[ind];

        int mid = (st + ed) / 2;

        Node left = find(2 * ind + 1, st, mid, l, r);
        Node right = find(2 * ind + 2, mid + 1, ed, l, r);

        if (left == null)
            return right;

        if (right == null)
            return left;

        return merge(left, right);
    }

