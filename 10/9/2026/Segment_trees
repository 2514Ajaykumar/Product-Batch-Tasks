import java.util.*;
public class tasksegmentGCD {
    static int tree[];
    static void build(int ind,int st,int ed,int arr[]){
        if(st==ed){
            tree[ind]=arr[st];
            return;
        }

        int mid=(st+ed)/2;
        build(2*ind+1,st,mid,arr);
        build(2*ind+2,mid+1,ed,arr);
        tree[ind]=findGCD(tree[2*ind+1],tree[2*ind+2]);
    }
    static int findGCD(int a,int b){
        return (b==0)?a:findGCD(b,a%b);
    }
    static int find(int ind,int st,int ed,int arr[],int i,int j){
        if(i>ed || j<st) return 0;
        if(i<=st && ed<=j){
            return tree[ind];
        }

        int mid=(st+ed)/2;
        int left=find(2*ind+1,st,mid,arr,i,j);
        int right=find(2*ind+2,mid+1,ed,arr,i,j);
        return findGCD(left, right);
    }
    static void update(int ind,int st,int ed,int arr[],int index,int val){
        if(st==ed){
            tree[ind]=val;
            return ;
        }
        int mid=(st+ed)/2;
        if(index<=mid){
            update(ind,st,mid,arr,index,val);
        }else{
            update(ind,mid+1,ed,arr,index,val);
        }

        tree[ind]=findGCD(tree[2*ind+1],tree[2*ind+2]);
    }
    public static void main(String []args){
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int arr[]=new int[n];
