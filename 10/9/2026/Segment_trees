public class segmentlongestone {

    static class Node {
        int prefix, suffix, best, len;

        Node(int prefix, int suffix, int best, int len) {
            this.prefix = prefix;
            this.suffix = suffix;
            this.best = best;
            this.len = len;
        }
    }

    static Node tree[];

    static Node merge(Node a, Node b) {
        if (a == null)
            return b;

        if (b == null)
            return a;

        int prefix = a.prefix;
        int suffix = b.suffix;

        if (a.prefix == a.len)
            prefix = a.len + b.prefix;

        if (b.suffix == b.len)
            suffix = b.len + a.suffix;

        int best = Math.max(a.best, b.best);
        best = Math.max(best, a.suffix + b.prefix);

        return new Node(prefix, suffix, best, a.len + b.len);
    }

    static void build(int ind, int st, int ed, int arr[]) {
        if (st == ed) {
            tree[ind] = new Node(arr[st], arr[st], arr[st], 1);
            return;
        }

        int mid = (st + ed) / 2;

        build(2 * ind + 1, st, mid, arr);
        build(2 * ind + 2, mid + 1, ed, arr);

        tree[ind] = merge(tree[2 * ind + 1], tree[2 * ind + 2]);
    }

    static void update(int ind, int st, int ed, int index, int val) {
        if (st == ed) {
            tree[ind] = new Node(val, val, val, 1);
            return;
        }

        int mid = (st + ed) / 2;

        if (index <= mid)
            update(2 * ind + 1, st, mid, index, val);
        else
            update(2 * ind + 2, mid + 1, ed, index, val);

        tree[ind] = merge(tree[2 * ind + 1], tree[2 * ind + 2]);
    }

    static Node find(int ind, int st, int ed, int l, int r) {
        if (l > ed || r < st)
            return null;

        if (l <= st && ed <= r)
            return tree[ind];

        int mid = (st + ed) / 2;

        Node left = find(2 * ind + 1, st, mid, l, r);
        Node right = find(2 * ind + 2, mid + 1, ed, l, r);

        return merge(left, right);
    }

    public static void main(String args[]) {
        Scanner obj = new Scanner(System.in);

        int n = obj.nextInt();
        int arr[] = new int[n];
        tree = new Node[4 * n];

        for (int i = 0; i < n; i++)
            arr[i] = obj.nextInt();

        build(0, 0, n - 1, arr);

        int q = obj.nextInt();

        while (q-- > 0) {
            int type = obj.nextInt();

            if (type == 1) {
                int index = obj.nextInt();
                int val = obj.nextInt();

                arr[index] = val;
                update(0, 0, n - 1, index, val);

            } else {
                int l = obj.nextInt();
                int r = obj.nextInt();

                System.out.println(find(0, 0, n - 1, l, r).best);
            }
        }
